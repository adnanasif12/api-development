PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=blogdb
DB_USER=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Used to build the password-reset link sent by email
FRONTEND_URL=http://localhost:3000
# Optional SMTP. If SMTP_HOST is empty the reset link is printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BlogSpace <no-reply@blogspace.local>
